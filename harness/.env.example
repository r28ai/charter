# charter-harness — credentials for the accounts the scenarios run against.
# Copy to .env (gitignored). Names only here; never commit values.

# Model (Inspect AI's fireworks/ provider)
FIREWORKS_API_KEY=

# Google — one OAuth client + one refresh token shared by gmail/gcalendar/gsheets/gdocs.
# Obtain the refresh token once with: python scripts/connect_google.py
# The redirect URI must be one registered on the OAuth client (localhost, with a
# port); the Surf Buddy client uses http://localhost:10002/auth/provider/callback.
# The Cloud project must have the Drive API enabled: two scenarios read Drive
# inside observe(), and every Docs/Sheets teardown deletes through it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:10002/auth/provider/callback
GOOGLE_REFRESH_TOKEN=

# Stripe — a TEST mode secret key (sk_test_...). Live keys are refused.
STRIPE_API_KEY=

# GitHub — a token with Issues, Contents and Pull requests read/write on the
# sandbox repo. Create GITHUB_OWNER/GITHUB_SANDBOX_REPO once, by hand, PUBLIC and
# initialised with a README: a fine-grained PAT cannot create repositories, and
# firecrawl_to_linear scrapes a blob in it anonymously. The harness writes nowhere else.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_SANDBOX_REPO=harness-sandbox

# Linear — personal API key of a throwaway workspace, and the team key (e.g. ENG).
LINEAR_API_KEY=
LINEAR_TEAM_KEY=

# Shopify — a development store and an Admin API access token. A custom app's
# token (Settings > Apps > Develop apps) does not expire; a token from
# `shopify store auth` does, 24 hours after issue, despite the shpat_ prefix.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Slack — bot token with chat:write, channels:history, channels:read, channels:join,
# channels:manage, groups:history, reactions:write, users:read; the bot must be a
# member of SLACK_CHANNEL.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=harness

# Firecrawl
FIRECRAWL_API_KEY=

# Harness
HARNESS_TIMEZONE=Europe/Paris

# Tavily. Free tier is enough for the suite; search and extract spend credits.
TAVILY_API_KEY=
